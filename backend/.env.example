# Copy to .env for local runs. Never commit real secrets (Phase 10).

# Server
PORT=3000
HOST=0.0.0.0

# Auth — MUST be set to a strong random value in production.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Database — when unset, the API uses in-memory storage.
# Production: a Postgres instance in an Australian region (Phase 10).
# DATABASE_URL=postgresql://user:password@localhost:5432/aurelle

# Identity verification (Stripe Identity). When STRIPE_SECRET_KEY is set the API
# switches from the simulation provider to real Stripe sessions + webhooks.
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx   # from the Stripe dashboard webhook endpoint

# Admin bootstrap — creates the first superadmin on boot if none exists (dev/ops).
# ADMIN_EMAIL=ops@yourdomain.com
# ADMIN_PASSWORD=change-me-strong
